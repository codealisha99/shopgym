# Copy to .env and fill in only what you use. The keyless demo needs none of these.
# The app and harness read these from the environment (for example: set -a; . ./.env; set +a).
SHOPGYM_PROVIDER=anthropic        # anthropic | openai (any OpenAI-compatible server)
ANTHROPIC_API_KEY=                # used when SHOPGYM_PROVIDER=anthropic
SHOPGYM_MODEL=claude-sonnet-5-5   # model id for the llm agent
# SHOPGYM_BASE_URL=http://localhost:11434/v1   # openai provider, e.g. Ollama
# SHOPGYM_API_KEY=                             # openai provider, only if the server needs one
SHOPGYM_DATA_DIR=data             # seed templates, episode databases, default shop database
